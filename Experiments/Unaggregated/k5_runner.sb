#!/bin/bash
########## Define Resources Needed with SBATCH Lines ##########
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-360%30
#SBATCH --cpus-per-task=8
#SBATCH -t 15:00:00
#SBATCH --mem=150GB
#SBATCH --job-name=k5-uag
#SBATCH -p defq,moore
#SBATCH --exclude=esplhpc-cp040
###############################################################

# load conda environment
source /home/hernandezj45/anaconda3/etc/profile.d/conda.sh
conda activate tpot2-env-3.10
pip install -e /home/hernandezj45/Repos/lexidate-cv-analysis/3-step-ea/

# Define the output directory
DATA_DIR=/home/hernandezj45/Repos/lexidate-cv-analysis/Results/K_5/Unaggregated
mkdir -p ${DATA_DIR}

# mandatory variables
EXP_OFFSET=20000
SPLIT_OFFSET=800
SEED=$((SLURM_ARRAY_TASK_ID + SPLIT_OFFSET + EXP_OFFSET))

##################################
# Treatments
##################################

TASK_146818_MIN=1
TASK_146818_MAX=30

TASK_359954_MIN=31
TASK_359954_MAX=60

TASK_359955_MIN=61
TASK_359955_MAX=90

TASK_190146_MIN=91
TASK_190146_MAX=120

TASK_168757_MIN=121
TASK_168757_MAX=150

TASK_359956_MIN=151
TASK_359956_MAX=180

TASK_359958_MIN=181
TASK_359958_MAX=210

TASK_359959_MIN=211
TASK_359959_MAX=240

TASK_2073_MIN=241
TASK_2073_MAX=270

TASK_359960_MIN=271
TASK_359960_MAX=300

TASK_168784_MIN=301
TASK_168784_MAX=330

TASK_359962_MIN=331
TASK_359962_MAX=360

##################################
# Conditions
##################################

if [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_146818_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_146818_MAX} ] ; then
  TASK_ID=146818
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359954_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359954_MAX} ] ; then
    TASK_ID=359954
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359955_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359955_MAX} ] ; then
    TASK_ID=359955
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_190146_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_190146_MAX} ] ; then
    TASK_ID=190146
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_168757_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_168757_MAX} ] ; then
    TASK_ID=168757
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359956_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359956_MAX} ] ; then
    TASK_ID=359956
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359958_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359958_MAX} ] ; then
    TASK_ID=359958
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359959_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359959_MAX} ] ; then
    TASK_ID=359959
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_2073_MIN} ]   && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_2073_MAX} ] ; then
    TASK_ID=2073
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359960_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359960_MAX} ] ; then
    TASK_ID=359960
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_168784_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_168784_MAX} ] ; then
    TASK_ID=168784
elif [ ${SLURM_ARRAY_TASK_ID} -ge ${TASK_359962_MIN} ] && [ ${SLURM_ARRAY_TASK_ID} -le ${TASK_359962_MAX} ] ; then
    TASK_ID=359962
else
  echo "${SEED} from ${TASK_ID} and ${SCHEME} failed to launch" >> /home/hernandezj45/Repos/lexidate-cv-analysis/Results/K_5/failtolaunch.txt
fi

# let it rip
python /home/hernandezj45/Repos/lexidate-cv-analysis/Source/experiment.py \
-validation unaggregated \
-k 5 \
-task_id ${TASK_ID} \
-n_jobs 8 \
-savepath ${DATA_DIR} \
-seed ${SEED} \